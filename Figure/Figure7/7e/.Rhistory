plot.title = element_text(size = 14,face = 'bold',hjust = 0.5),
axis.text.x = element_text(size = 17),axis.text.y = element_text(size = 17),
axis.title = element_text(size = 18),
legend.position = 'none'
) +
labs(
title = 'g_Phocaeicola',
x = "",
y = "Abundance (TPM)"
)
