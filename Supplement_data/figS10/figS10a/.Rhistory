phe = phe[,-c(1,2)]
View(phe)
phe = as.data.frame(t(phe))
View(phe)
phe_scale = t(scale(t(phe)))
View(phe_scale)
group.col = read.delim('group.GT.txt',header=T)  #样本分组，基因型
rownames(group.col) = group.col$id
